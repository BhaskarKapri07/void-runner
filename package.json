{
  "name": "void-runner",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test",
    "build:client": "node scripts/build-client.js",
    "bench:net": "node scripts/netbench.js",
    "deploy:cloudflare": "wrangler deploy",
    "dev:cloudflare": "wrangler dev --local --port 8787",
    "check:cloudflare": "wrangler deploy --dry-run --outdir .cloudflare-build"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "wrangler": "^4.129.0"
  }
}
